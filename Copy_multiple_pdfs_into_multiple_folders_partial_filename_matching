# =====================================================
# CHECK DIRECTORY
# =====================================================

if (!(Test-Path -LiteralPath $parentPath -PathType Container)) {
    Write-Host "ERROR: Directory not found!" -ForegroundColor Red
    return
}

# Get PDF files from the main directory only
$pdfFiles = Get-ChildItem -LiteralPath $parentPath -Filter "*.pdf" -File

# =====================================================
# INITIALIZE COUNTERS
# =====================================================

$copied = 0
$missing = 0
$duplicates = 0
$folderNotFound = 0
$alreadyExists = 0
$failed = 0

# =====================================================
# MATCH AND COPY PDF FILES
# =====================================================

foreach ($folder in $folderNames) {

    $targetFolder = Join-Path $parentPath $folder

    if (!(Test-Path -LiteralPath $targetFolder -PathType Container)) {
        Write-Host "FOLDER NOT FOUND: $folder" -ForegroundColor Red
        $folderNotFound++
        continue
    }

    # Partial filename matching:
    # PDF filename must start with the folder name
    $matchingPDFs = @(
        $pdfFiles | Where-Object {
            $_.BaseName.StartsWith(
                $folder,
                [System.StringComparison]::OrdinalIgnoreCase
            )
        }
    )

    if ($matchingPDFs.Count -eq 0) {
        Write-Host "PDF NOT FOUND: $folder" -ForegroundColor Red
        $missing++
        continue
    }

    if ($matchingPDFs.Count -gt 1) {
        Write-Host "MULTIPLE MATCHES: $folder" -ForegroundColor Yellow
        foreach ($pdf in $matchingPDFs) {
            Write-Host "   $($pdf.Name)" -ForegroundColor Yellow
        }
        $duplicates++
        continue
    }

    $pdf = $matchingPDFs[0]
    $destinationFile = Join-Path $targetFolder $pdf.Name

    if (Test-Path -LiteralPath $destinationFile) {
        Write-Host "ALREADY EXISTS: $($pdf.Name)" -ForegroundColor Yellow
        $alreadyExists++
        continue
    }

    try {
        Copy-Item -LiteralPath $pdf.FullName `
                  -Destination $targetFolder `
                  -ErrorAction Stop

        Write-Host "COPIED: $($pdf.Name)" -ForegroundColor Green
        $copied++
    }
    catch {
        Write-Host "COPY FAILED: $($pdf.Name)" -ForegroundColor Red
        Write-Host $_.Exception.Message
        $failed++
    }
}

# =====================================================
# FINAL SUMMARY
# =====================================================

Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "             COPY SUMMARY               " -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

Write-Host "Total folders       : $($folderNames.Count)"
Write-Host "PDFs copied         : $copied" -ForegroundColor Green
Write-Host "Already existing    : $alreadyExists" -ForegroundColor Yellow
Write-Host "PDFs not found      : $missing" -ForegroundColor Red
Write-Host "Folders not found   : $folderNotFound" -ForegroundColor Red
Write-Host "Multiple matches    : $duplicates" -ForegroundColor Yellow
Write-Host "Copy failures       : $failed" -ForegroundColor Red

Write-Host "`nPROCESS COMPLETED!" -ForegroundColor Green
