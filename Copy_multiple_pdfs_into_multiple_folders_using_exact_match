# =====================================================
# CHECK MAIN DIRECTORY
# =====================================================

if (!(Test-Path -LiteralPath $parentPath -PathType Container)) {
    Write-Host "ERROR: Main directory not found!" -ForegroundColor Red
    return
}

# =====================================================
# GET ALL PDF FILES FROM MAIN DIRECTORY
# =====================================================

$pdfFiles = Get-ChildItem -LiteralPath $parentPath -Filter "*.pdf" -File

# =====================================================
# INITIALIZE COUNTERS
# =====================================================

$copied = 0
$missing = 0
$duplicates = 0
$folderNotFound = 0
$alreadyExists = 0
$failed = 0

# =====================================================
# MATCH AND COPY PDF FILES
# =====================================================

foreach ($folder in $folderNames) {

    $targetFolder = Join-Path -Path $parentPath -ChildPath $folder

    # Check whether destination folder exists
    if (!(Test-Path -LiteralPath $targetFolder -PathType Container)) {
        Write-Host "FOLDER NOT FOUND: $folder" -ForegroundColor Red
        $folderNotFound++
        continue
    }

    # Find PDF with exactly matching filename
    $matchingPDFs = @(
        $pdfFiles | Where-Object {
            [System.IO.Path]::GetFileNameWithoutExtension($_.Name) -ieq $folder
        }
    )

    if ($matchingPDFs.Count -eq 0) {
        Write-Host "PDF NOT FOUND: $folder" -ForegroundColor Red
        $missing++
        continue
    }

    if ($matchingPDFs.Count -gt 1) {
        Write-Host "DUPLICATE PDF FOUND: $folder" -ForegroundColor Yellow
        $duplicates++
        continue
    }

    $pdf = $matchingPDFs[0]

    $destinationFile = Join-Path -Path $targetFolder -ChildPath $pdf.Name

    # Skip if PDF already exists in destination
    if (Test-Path -LiteralPath $destinationFile) {
        Write-Host "ALREADY EXISTS: $folder" -ForegroundColor Yellow
        $alreadyExists++
        continue
    }

    # Copy PDF into matching folder
    try {
        Copy-Item -LiteralPath $pdf.FullName -Destination $targetFolder -ErrorAction Stop

        Write-Host "COPIED: $($pdf.Name)" -ForegroundColor Green
        $copied++
    }
    catch {
        Write-Host "COPY FAILED: $($pdf.Name) - $($_.Exception.Message)" -ForegroundColor Red
        $failed++
    }
}

# =====================================================
# FINAL SUMMARY
# =====================================================

Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "           FINAL COPY SUMMARY           " -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

Write-Host "Total folder names  : $($folderNames.Count)"
Write-Host "PDFs copied         : $copied" -ForegroundColor Green
Write-Host "Already existing    : $alreadyExists" -ForegroundColor Yellow
Write-Host "PDFs not found      : $missing" -ForegroundColor Red
Write-Host "Folders not found   : $folderNotFound" -ForegroundColor Red
Write-Host "Duplicate PDFs      : $duplicates" -ForegroundColor Yellow
Write-Host "Copy failures       : $failed" -ForegroundColor Red

Write-Host "`nDestination:"
Write-Host $parentPath -ForegroundColor Cyan

Write-Host "`nPROCESS COMPLETED!" -ForegroundColor Green

